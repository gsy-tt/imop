/*
 * JDCloud BE6500 router device tree (IPQ5332)
 * Hardware: 1GB DDR4 / 128GB eMMC / QCA8386 switch / QCN6224 wireless
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/clock/qcom,ipq5332-gcc.h>
#include "ipq5332.dtsi"

/ {
    model = "JDCloud BE6500";
    compatible = "jdcloud,be6500", "qcom,ipq5332";

    /* Power regulator (stable power for wireless/peripherals) */
    vreg_l12a: regulator-l12a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-0.8-cx-mx";
        regulator-min-microvolt = <800000>;
        regulator-max-microvolt = <800000>;
        regulator-always-on;
        regulator-boot-on;
    };

    vreg_l13a: regulator-l13a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-1.8-cx";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
        regulator-boot-on;
    };

    vreg_usb3: regulator-usb3 {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-usb3-3.3v";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-boot-on;
    };

    /* 1GB DDR4 memory (SK Hynix H5AN8G6NDJRXNC) */
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x40000000>; // Start address 0x40000000, size 1GB
    };

    /* Boot parameters (required for kernel boot) */
    chosen {
        bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial_dm,0x078af000 rootfstype=squashfs,jffs2 rootwait";
    };

    /* Device aliases (simplify system references) */
    aliases {
        led-boot = &led_power;
        led-failsafe = &led_power;
        led-running = &led_power;
        led-upgrade = &led_power;
        serial0 = &blsp1_uart0;
        ethernet0 = &gmac0;
        wifi0 = &wlan_2g;  // 2.4G wireless
        wifi1 = &wlan_5g;  // 5G wireless
    };

    /* LED configuration (matching physical LED positions) */
    leds {
        compatible = "gpio-leds";

        // Power LED (green, always on)
        led_power: power {
            label = "jdcloud:green:power";
            gpios = <&tlmm 32 GPIO_ACTIVE_LOW>; // Need to verify actual GPIO
            default-state = "on";
            retain-state-suspended;
        };

        // 2.4G wireless LED (blue, associated with wireless status)
        led_wifi_2g: wifi-2g {
            label = "jdcloud:blue:wifi2g";
            gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
            default-state = "off";
            linux,default-trigger = "phy0tpt";
        };

        // 5G wireless LED (blue, associated with wireless status)
        led_wifi_5g: wifi5g {
            label = "jdcloud:blue:wifi5g";
            gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
            default-state = "off";
            linux,default-trigger = "phy1tpt";
        };


        led_joy: joy {
            label = "jdcloud:rgb:joy";
            gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };
    };

    /* Button configuration (reset, WPS) */
    keys {
        compatible = "gpio-keys";

        // Reset button (long press to restore factory settings)
        reset {
            label = "reset";
            gpios = <&tlmm 32 GPIO_ACTIVE_LOW>; // Need to verify actual GPIO
            linux,code = <KEY_RESTART>;
            debounce-interval = <200>; // Debounce time 200ms
        };

        // Joy button (control LED/mesh networking)
        joy {
            label = "joy";
            gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_FN>; // Map to function key
            debounce-interval = <200>;
        };
    };
};

/* Debug serial port (UART0, GPIO18/19) */
&blsp1_uart0 {
    pinctrl-0 = <&serial_0_pins>;
    pinctrl-names = "default";
    status = "okay";
};

/* 128GB eMMC (Longsys E128CSDA2ABE00) */
&sdhc {
    compatible = "qcom,ipq5332-sdhci", "qcom,sdhci-msm-v5";
    reg = <0x07804000 0x1000>, <0x07805000 0x1000>;
    interrupts = <GIC_SPI 313 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_SDCC1_AHB_CLK>,
             <&gcc GCC_SDCC1_APPS_CLK>,
             <&xo_board>;
    clock-names = "iface", "core", "xo";
    bus-width = <8>; // 8-bit data bus
    non-removable; // Onboard, non-removable
    no-1-8-v; // Operating voltage 3.3V (not 1.8V)
    cap-mmc-highspeed; // Enable high-speed mode
    max-frequency = <200000000>; // Maximum 200MHz
    status = "okay";

    /* eMMC partition table (strictly match U-Boot) */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <2>;
        #size-cells = <2>;

        partition@0 {
            label = "boot";
            reg = <0x0 0x0 0x0 0x800000>; // 8MB (boot partition)
        };
        partition@800000 {
            label = "kernel";
            reg = <0x0 0x800000 0x0 0x1000000>; // 16MB (kernel partition)
        };
        partition@1800000 {
            label = "rootfs";
            reg = <0x0 0x1800000 0x0 0x7E800000>; // ~2GB (root filesystem)
        };
        partition@80000000 {
            label = "data";
            reg = <0x0 0x80000000 0x0 0x78000000>; // Remaining space (~1.9GB user data)
        };
    };
};

/* USB 3.0 interface */
&usb3 {
    compatible = "qcom,dwc3";
    reg = <0x08800000 0x10000>;
    interrupts = <GIC_SPI 37 0>;
    clocks = <&gcc GCC_USB30_MASTER_CLK>,
             <&gcc GCC_USB30_SLEEP_CLK>;
    clock-names = "core", "sleep";
    dr_mode = "host"; // Host mode
    vbus-supply = <&vreg_usb3>; // 3.3V power supply
    status = "okay";

    /* USB 3.0 PHY configuration */
    usb3_phy: phy {
        compatible = "qcom,ipq5332-usb3-phy";
        #phy-cells = <0>;
        clocks = <&gcc GCC_USB30_MASTER_CLK>,
                 <&xo_board>;
        clock-names = "ref", "xo";
        status = "okay";
    };
};

/* Ethernet controller (connect to QCA8386 switch chip) */
&gmac0 {
    status = "okay";
    pinctrl-0 = <&gmac0_pins>;
    pinctrl-names = "default";
    phy-mode = "rgmii"; // Interface mode with switch chip
    phy-handle = <&qca8386>; // Associated switch chip

    /* 2.5G connection with switch chip */
    fixed-link {
        speed = <2500>; // 2.5Gbps speed
        full-duplex;
        pause; // Support flow control
    };
};

/* MDIO bus (manage QCA8386 switch chip) */
&mdio {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    /* QCA8386 2.5G switch chip (1WAN+3LAN) */
    qca8386: switch@0 {
        compatible = "qca,qca8386";
        reg = <0x0>; // MDIO address 0
        reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>; // Reset pin (need to verify)
        reset-assert-us = <10000>; // Reset assert time 10ms
        reset-deassert-us = <10000>; // Reset deassert time 10ms

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            // LAN port 1 (physical port 2)
            port@0 {
                reg = <0>;
                label = "lan1";
                phy-mode = "rgmii";
            };

            // LAN port 2 (physical port 3)
            port@1 {
                reg = <1>;
                label = "lan2";
                phy-mode = "rgmii";
            };

            // LAN port 3 (physical port 4)
            port@2 {
                reg = <2>;
                label = "lan3";
                phy-mode = "rgmii";
            };

            // WAN port (physical port 1)
            port@5 {
                reg = <5>;
                label = "wan";
                phy-mode = "rgmii";
                // VLAN isolation configuration (match firmware network config)
                vlan-mode = "secure";
                vlan = <1 0x2>; // Belong to VLAN 1, marked as WAN
            };

            // CPU port (connect to IPQ5332 gmac0)
            port@6 {
                reg = <6>;
                label = "cpu";
                phy-mode = "rgmii";
                fixed-link {
                    speed = <2500>;
                    full-duplex;
                    pause;
                };
            };
        };
    };
};

/* 2.4G wireless (IPQ5332 built-in, Wi-Fi 7) */
&wlan_2g {
    compatible = "qcom,ath11k";
    status = "okay";
    qcom,chip-id = <0x0>; // Built-in 2.4G chip ID
    qcom,board-id = <0x200>; // Calibration ID (need to match actual calibration data)
    vdd-0.8-cx-mx-supply = <&vreg_l12a>; // 0.8V power supply
    vdd-1.8-cx-supply = <&vreg_l13a>; // 1.8V power supply
    pinctrl-0 = <&wlan2g_pins>;
    pinctrl-names = "default";
};

/* 5G wireless (QCN6224, PCIe interface) */
&pcie0 {
    compatible = "qcom,ipq5332-pcie";
    reg = <0x10000000 0x1000000>;
    interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_PCIE0_CLK>,
             <&gcc GCC_PCIE0_AHB_CLK>;
    clock-names = "core", "iface";
    num-lanes = <1>; // 1 PCIe lane
    status = "okay";
    pinctrl-0 = <&pcie0_pins>;
    pinctrl-names = "default";

    wlan_5g: wifi@0,0 {
        compatible = "qcom,ath11k";
        reg = <0 0 0 0 0>; // PCIe address mapping address mapping
        qcom,chip-id = <0x6224>; // QCN6224 chip ID
        qcom,board-id = <0x1000>; // Calibration ID
        qcom,160mhz-support = <1>;
        qcom,mlo-support = <1>;
        vdd-0.8-cx-mx-supply = <&vreg_l12a>;
        vdd-1.8-cx-supply = <&vreg_l13a>;
        status = "okay";
    };
};

/* Pin multiplex controller (TLMM) */
&tlmm {
    /* GMAC0 RGMII pins (connect to QCA8386) */
    gmac0_pins: gmac0-state {
        mux {
            pins = "gpio4",  // RGMII_MDC
                   "gpio5",  // RGMII_MDIO
                   "gpio6",  // RGMII_TXD0
                   "gpio7",  // RGMII_TXD1
                   "gpio8",  // RGMII_TXD2
                   "gpio9",  // RGMII_TXD3
                   "gpio10", // RGMII_TX_CTRL
                   "gpio11", // RGMII_TX_CLK
                   "gpio12", // RGMII_RXD0
                   "gpio13", // RGMII_RXD1
                   "gpio14", // RGMII_RXD2
                   "gpio15", // RGMII_RXD3
                   "gpio16", // RGMII_RX_CTRL
                   "gpio17"; // RGMII_RX_CLK
            function = "rgmii";
            drive-strength = <16>; // 16mA drive strength
            bias-disable; // no pull-up/pull-down
        };
    };

    /* PCIe0 pins (connect to QCN6224) */
    pcie0_pins: pcie0-state {
        mux {
            pins = "gpio48",  // PCIe_RST_N (reset)
                   "gpio49";  // PCIe_CLKREQ (clock request)
            function = "pcie";
            drive-strength = <8>;
            bias-pull-up; // Reset pin default pull-up (active)
        };
    };

    /* 2.4G wireless control pins */
    wlan2g_pins: wlan2g-state {
        mux {
            pins = "gpio50",  // WLAN_2G_RST (reset)
               "gpio51";
            function = "wlan";
            drive-strength = <8>;
            bias-pull-up;
        };
    };
};

/* CPU frequency configuration (matching 1.5GHz hardware specifications) */
&cpu_opp_table {
    opp-1500000000 {
        opp-hz = /bits/ 64 <1500000000>;
        clock-latency-ns = <200000>;
    };
};
