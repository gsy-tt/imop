/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "ipq5332-base.dtsi"  // 引用芯片级基础设备树

/ {
    model = "JDCloud BE6500";  // 规范设备型号命名
    compatible = "jdcloud,be6500", "qcom,ipq5332";  // 优先设备厂商标识

    /* 电源调节器（为Wi-Fi等外设供电） */
    vreg_l12a: regulator-l12a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-0.8-cx-mx";
        regulator-min-microvolt = <800000>;
        regulator-max-microvolt = <800000>;
        regulator-always-on;  // 核心供电，始终开启
    };

    vreg_l13a: regulator-l13a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-1.8-cx";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    /* 内存配置（1GB DDR4，起始地址0x40000000） */
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x40000000>;  // 修正地址格式（起始地址+大小）
    };

    chosen {
        bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial_dm,0x078af000 rootfstype=squashfs,jffs2 rootwait";
        // 增加rootwait确保根文件系统就绪
    };

    aliases {
        led-boot = &led_power;
        led-failsafe = &led_power;
        led-running = &led_power;
        led-upgrade = &led_power;
        serial0 = &blsp1_uart0;  // 对应base.dtsi中的串口节点名
        ethernet0 = &gmac;  // 增加以太网别名，方便OpenWRT识别
    };

    /* LED配置（按功能分组，规范标签命名） */
    leds {
        compatible = "gpio-leds";

        led_power: power {
            label = "jdcloud:green:power";  // 前缀统一为厂商名
            gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
            default-state = "on";
            retain-state-suspended;
        };

        led_wifi_2g: wifi-2g {
            label = "jdcloud:blue:wifi2g";
            gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };

        led_wifi_5g: wifi-5g {
            label = "jdcloud:blue:wifi5g";
            gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };

        led_joy: joy {
            label = "jdcloud:rgb:joy";
            gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };
    };

    /* 按键配置（规范键值定义） */
    keys {
        compatible = "gpio-keys";

        reset {
            label = "reset";
            gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_RESTART>;  // 标准重启键值
            debounce-interval = <200>;  // 防抖动间隔
        };

        joy {
            label = "joy";
            gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_PROG1>;  // 自定义功能键
            debounce-interval = <200>;
        };
    };
};

/* 串口配置（复用base.dtsi中的blsp1_uart0节点） */
&blsp1_uart0 {
    pinctrl-0 = <&serial_0_pins>;  // 引用base.dtsi中定义的引脚组
    pinctrl-names = "default";
    status = "okay";  // 启用串口调试
};

/* eMMC存储控制器（复用base.dtsi中的sdhc节点，修正配置） */
&sdhc {
    compatible = "qcom,ipq5332-sdhci", "qcom,sdhci-msm-v5";
    reg = <0x07804000 0x1000>, <0x07805000 0x1000>;  // 与base.dtsi地址一致
    interrupts = <GIC_SPI 313 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
    interrupt-names = "hc_irq", "pwr_irq";
    clocks = <&gcc GCC_SDCC1_AHB_CLK>,
             <&gcc GCC_SDCC1_APPS_CLK>,
             <&xo_board>;
    clock-names = "iface", "core", "xo";
    bus-width = <8>;  // eMMC为8位总线
    non-removable;  // 板载eMMC不可移除
    no-1-8-v;  // 不支持1.8V电压
    status = "okay";  // 启用eMMC
};

/* USB 3.0控制器（补充标准配置） */
&usb3 {
    compatible = "qcom,ipq5332-dwc3";
    reg = <0x08800000 0x10000>;
    interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_USB30_MASTER_CLK>,
             <&gcc GCC_USB30_SLEEP_CLK>;
    clock-names = "core", "sleep";
    dr_mode = "host";  // 主机模式
    status = "okay";

    /* USB 3.0 PHY（物理层配置） */
    usb3_phy: phy {
        compatible = "qcom,ipq5332-usb-phy";
        #phy-cells = <0>;
        clocks = <&gcc GCC_USB30_MASTER_CLK>;
        status = "okay";
    };
};

/* 以太网控制器（基于GMAC，修正节点引用） */
&gmac {
    status = "okay";
    pinctrl-0 = <&gmac_pins>;  // 引用GMAC专用引脚组
    pinctrl-names = "default";
    phy-mode = "rgmii";  // 采用RGMII接口
    phy-handle = <&phy0>;  // 关联PHY芯片

    /* 网口配置（2.5G网口，支持千兆/2.5G自适应） */
    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            label = "wan";  // 明确标识为WAN口
        };

        port@1 {
            reg = <1>;
            label = "lan1";  // LAN口1
        };

        port@2 {
            reg = <2>;
            label = "lan2";  // LAN口2
        };
    };

    /* MDIO总线（管理PHY芯片） */
    mdio {
        #address-cells = <1>;
        #size-cells = <0>;

        phy0: ethernet-phy@0 {
            reg = <0x0>;  // PHY地址0
            compatible = "realtek,rtl8221b", "ethernet-phy-ieee802.3-c45";
            max-speed = <2500>;  // 支持2.5G速率
            reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;  // PHY复位引脚（示例）
            reset-assert-us = <10000>;  // 复位时长10ms
            reset-deassert-us = <10000>;
        };
    };
};

/* PCIe控制器（用于Wi-Fi 6/7射频卡） */
&pcie0 {
    compatible = "qcom,ipq5332-pcie";
    reg = <0x10000000 0x1000000>;  // PCIe控制器地址
    interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_PCIE0_CLK>,
             <&gcc GCC_PCIE0_AHB_CLK>;
    clock-names = "core", "iface";
    num-lanes = <1>;  // 1条PCIe通道
    status = "okay";

    /* QCN6224 Wi-Fi芯片（5G/6G频段） */
    qcn6224: wifi@0,0 {
        compatible = "qcom,ath11k";
        reg = <0 0 0 0 0>;  // PCIe设备地址格式
        interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-parent = <&pcie0>;
        qcom,chip-id = <0x6224>;  // 芯片ID
        qcom,board-id = <0x1000>;  // 板载ID（需校准）
        qcom,mac-offset = <0x0>;  // MAC地址偏移
        vdd-0.8-cx-mx-supply = <&vreg_l12a>;  // 供电关联
        vdd-1.8-cx-supply = <&vreg_l13a>;
        power-domains = <&gcc 0>;  // 修正为base.dtsi中的gcc节点
        status = "okay";
    };
};

/* 引脚控制器（整理WAN/LAN引脚配置） */
&tlmm {
    gmac_pins: gmac-state {
        /* GMAC共用引脚（RGMII时钟等） */
        mux {
            pins = "gpio5",  // RGMII_REF_CLK
                   "gpio4";  // RGMII_MDC
            function = "rgmii";
            drive-strength = <16>;  // 增强驱动能力（16mA）
            bias-disable;  // 禁用上下拉
        };
    };

    wan_pins: wan-state {
        /* WAN口RGMII数据引脚 */
        mux {
            pins = "gpio6",  // RGMII_TXD0
                   "gpio7",  // RGMII_TXD1
                   "gpio8",  // RGMII_TXD2
                   "gpio9",  // RGMII_TXD3
                   "gpio10", // RGMII_TX_CTRL
                   "gpio11", // RGMII_TX_CLK
                   "gpio12", // RGMII_RXD0
                   "gpio13", // RGMII_RXD1
                   "gpio14", // RGMII_RXD2
                   "gpio15", // RGMII_RXD3
                   "gpio16", // RGMII_RX_CTRL
                   "gpio17"; // RGMII_RX_CLK
            function = "rgmii";
            drive-strength = <16>;
            bias-disable;
        };
    };

    lan_pins: lan-state {
        /* LAN口RGMII数据引脚 */
        mux {
            pins = "gpio18", // RGMII_TXD0
                   "gpio19", // RGMII_TXD1
                   "gpio20", // RGMII_TXD2
                   "gpio21", // RGMII_TXD3
                   "gpio22", // RGMII_TX_CTRL
                   "gpio23", // RGMII_TX_CLK
                   "gpio24", // RGMII_RXD0
                   "gpio25", // RGMII_RXD1
                   "gpio26", // RGMII_RXD2
                   "gpio27", // RGMII_RXD3
                   "gpio28", // RGMII_RX_CTRL
                   "gpio29"; // RGMII_RX_CLK
            function = "rgmii";
            drive-strength = <16>;
            bias-disable;
        };
    };
};
