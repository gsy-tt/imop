/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/clock/qcom,ipq5332-gcc.h>
#include "ipq5332.dtsi"  // 保持与芯片级dtsi的正确关联


/ {
    model = "JDCloud BE6500";
    compatible = "jdcloud,be6500", "qcom,ipq5332";

    /* 电源调节器（匹配IPQ5332 PMIC配置） */
    vreg_l12a: regulator-l12a {
        compatible = "qcom,pm8005-regulator";  // 确认PMIC型号匹配
        regulator-name = "vdd-0.8-cx-mx";
        regulator-min-microvolt = <800000>;
        regulator-max-microvolt = <800000>;
        regulator-always-on;
        regulator-boot-on;  // 启动阶段即供电
    };

    vreg_l13a: regulator-l13a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-1.8-cx";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
        regulator-boot-on;
    };

    /* 1GB DDR4内存（明确地址范围） */
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x40000000>;  // 0x40000000 = 1GB
    };

    chosen {
        bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial_dm,0x078af000 rootfstype=squashfs,jffs2 rootwait";
    };

    aliases {
        led-boot = &led_power;
        led-failsafe = &led_power;
        led-running = &led_power;
        led-upgrade = &led_power;
        serial0 = &blsp1_uart0;
        ethernet0 = &gmac0;  // 修正网口控制器别名
        wifi0 = &wlan_2g;    // 新增2.4G无线别名
        wifi1 = &wlan_5g;    // 新增5G无线别名
    };

    /* LED配置（补充RGB灯控制逻辑） */
    leds {
        compatible = "gpio-leds";

        led_power: power {
            label = "jdcloud:green:power";
            gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
            default-state = "on";
            retain-state-suspended;
        };

        led_wifi_2g: wifi-2g {
            label = "jdcloud:blue:wifi2g";
            gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
            linux,default-trigger = "phy0tpt";  // 关联2.4G无线状态
        };

        led_wifi_5g: wifi5g {
            label = "jdcloud:blue:wifi5g";
            gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
            linux,default-trigger = "phy1tpt";  // 关联5G无线状态
        };

        led_joy: joy {
            label = "jdcloud:rgb:joy";
            gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };
    };

    /* 按键配置（规范功能映射） */
    keys {
        compatible = "gpio-keys";

        reset {
            label = "reset";
            gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_RESTART>;
            debounce-interval = <200>;
        };

        joy {
            label = "joy";
            gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_FN>;  // 功能键映射，适配LED控制逻辑
            debounce-interval = <200>;
        };
    };
};

/* 启用调试串口（复用芯片级引脚定义） */
&blsp1_uart0 {
    pinctrl-0 = <&serial_0_pins>;
    pinctrl-names = "default";
    status = "okay";
};

/* 128GB eMMC配置（优化高速模式参数） */
&sdhc {
    compatible = "qcom,ipq5332-sdhci", "qcom,sdhci-msm-v5";
    reg = <0x07804000 0x1000>, <0x07805000 0x1000>;
    interrupts = <GIC_SPI 313 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
    interrupt-names = "hc_irq", "pwr_irq";
    clocks = <&gcc GCC_SDCC1_AHB_CLK>,
             <&gcc GCC_SDCC1_APPS_CLK>,
             <&xo_board>;
    clock-names = "iface", "core", "xo";
    bus-width = <8>;
    non-removable;
    no-1-8-v;  // eMMC工作电压3.3V
    cap-mmc-highspeed;  // 启用高速模式
    mmc-hs200-1_8v;     // 支持HS200模式（需硬件支持）
    mmc-ddr-1_8v;       // 支持DDR模式
    max-frequency = <200000000>;  // 最高200MHz时钟
    status = "okay";
};

/* USB 3.0控制器（修正PHY和控制器兼容属性） */
&usb3 {
    compatible = "qcom,dwc3";  // 标准DWC3控制器兼容
    reg = <0x08800000 0x10000>;
    interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_USB30_MASTER_CLK>,
             <&gcc GCC_USB30_SLEEP_CLK>;
    clock-names = "core", "sleep";
    dr_mode = "host";
    status = "okay";

    /* USB 3.0 PHY配置（匹配IPQ5332 PHY型号） */
    usb3_phy: phy {
        compatible = "qcom,ipq5332-usb3-phy";
        #phy-cells = <0>;
        clocks = <&gcc GCC_USB30_MASTER_CLK>,
                 <&xo_board>;
        clock-names = "ref", "xo";
        status = "okay";
    };
};

/* 网络部分（修正QCA8386交换芯片拓扑） */
&gmac0 {  // 假设芯片级dtsi中以太网控制器节点为gmac0
    status = "okay";
    pinctrl-0 = <&gmac0_pins>;
    pinctrl-names = "default";
    phy-mode = "rgmii";
    phy-handle = <&qca8386>;  // 连接到交换芯片

    /* GMAC与交换芯片的CPU端口连接 */
    fixed-link {
        speed = <2500>;  // 与交换芯片采用2.5Gbps连接
        full-duplex;
        pause;
    };
};

/* MDIO总线（添加QCA8386交换芯片） */
&mdio {  // 假设芯片级dtsi中MDIO控制器节点为mdio
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    /* QCA8386 2.5G交换芯片（4个网口） */
    qca8386: switch@0 {
        compatible = "qca,qca8386";
        reg = <0x0>;  // MDIO地址0
        #address-cells = <1>;
        #size-cells = <0>;
        reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;  // 交换芯片复位引脚
        reset-assert-us = <10000>;
        reset-deassert-us = <10000>;

        /* 交换芯片网口配置（1WAN + 3LAN） */
        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                label = "lan1";
                phy-mode = "rgmii";
            };

            port@1 {
                reg = <1>;
                label = "lan2";
                phy-mode = "rgmii";
            };

            port@2 {
                reg = <2>;
                label = "lan3";
                phy-mode = "rgmii";
            };

            port@5 {
                reg = <5>;
                label = "wan";
                phy-mode = "rgmii";
            };

            /* CPU端口（连接GMAC） */
            port@6 {
                reg = <6>;
                label = "cpu";
                phy-mode = "rgmii";
                fixed-link {
                    speed = <2500>;
                    full-duplex;
                    pause;
                };
            };
        };
    };
};

/* 2.4G集成无线（IPQ5332内置） */
&wlan_2g {  // 假设芯片级dtsi中内置无线节点为wlan_2g
    compatible = "qcom,ath11k";
    status = "okay";
    qcom,chip-id = <0x0>;  // 内置2.4G芯片ID
    qcom,board-id = <0x200>;  // 板载校准ID
    vdd-0.8-cx-mx-supply = <&vreg_l12a>;
    vdd-1.8-cx-supply = <&vreg_l13a>;
    pinctrl-0 = <&wlan2g_pins>;
    pinctrl-names = "default";
};

/* 5G无线（QCN6224 PCIe设备） */
&pcie0 {
    compatible = "qcom,ipq5332-pcie";
    reg = <0x10000000 0x1000000>;
    interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_PCIE0_CLK>,
             <&gcc GCC_PCIE0_AHB_CLK>;
    clock-names = "core", "iface";
    num-lanes = <1>;
    status = "okay";
    pinctrl-0 = <&pcie0_pins>;
    pinctrl-names = "default";

    wlan_5g: wifi@0,0 {
        compatible = "qcom,ath11k";
        reg = <0 0 0 0 0>;
        interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-parent = <&pcie0>;
        qcom,chip-id = <0x6224>;  // QCN6224芯片ID
        qcom,board-id = <0x1000>;  // 板载校准ID（需实际校准）
        qcom,mac-offset = <0x0>;
        vdd-0.8-cx-mx-supply = <&vreg_l12a>;
        vdd-1.8-cx-supply = <&vreg_l13a>;
        power-domains = <&gcc 0>;
        status = "okay";
    };
};

/* 引脚控制器（补充PCIe和无线引脚） */
&tlmm {
    /* GMAC引脚（RGMII接口） */
    gmac0_pins: gmac0-state {
        mux {
            pins = "gpio4",  // RGMII_MDC
                   "gpio5",  // RGMII_MDIO
                   "gpio6",  // RGMII_TXD0
                   "gpio7",  // RGMII_TXD1
                   "gpio8",  // RGMII_TXD2
                   "gpio9",  // RGMII_TXD3
                   "gpio10", // RGMII_TX_CTRL
                   "gpio11", // RGMII_TX_CLK
                   "gpio12", // RGMII_RXD0
                   "gpio13", // RGMII_RXD1
                   "gpio14", // RGMII_RXD2
                   "gpio15", // RGMII_RXD3
                   "gpio16", // RGMII_RX_CTRL
                   "gpio17"; // RGMII_RX_CLK
            function = "rgmii";
            drive-strength = <16>;  // 16mA驱动
            bias-disable;
        };
    };

    /* PCIe引脚（复位和使能） */
    pcie0_pins: pcie0-state {
        mux {
            pins = "gpio48",  // PCIe RST_N
                   "gpio49";  // PCIe CLKREQ
            function = "pcie";
            drive-strength = <8>;
            bias-pull-up;  // 复位引脚默认上拉
        };
    };

    /* 2.4G无线引脚（控制） */
    wlan2g_pins: wlan2g-state {
        mux {
            pins = "gpio50",  // WLAN 2G RST
                   "gpio51";  // WLAN 2G EN
            function = "wlan";
            drive-strength = <8>;
            bias-pull-up;
        };
    };
};

/* 修正CPU频率（匹配1.5GHz规格） */
&cpu_opp_table {
    opp-1500000000 {
        opp-hz = /bits/ 64 <1500000000>;
        clock-latency-ns = <200000>;
    };
};
