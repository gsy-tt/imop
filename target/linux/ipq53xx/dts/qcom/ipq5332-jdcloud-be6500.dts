/*
 * 京东云BE6500路由器设备树（IPQ5332）
 * 硬件配置：1GB DDR4 / 128GB eMMC / QCA8386交换机 / QCN6224无线
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/clock/qcom,ipq5332-gcc.h>
#include "ipq5332.dtsi"

/ {
    model = "JDCloud BE6500";
    compatible = "jdcloud,be6500", "qcom,ipq5332";

    /* 电源调节器（为无线/外设提供稳定供电） */
    vreg_l12a: regulator-l12a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-0.8-cx-mx";
        regulator-min-microvolt = <800000>;
        regulator-max-microvolt = <800000>;
        regulator-always-on;
        regulator-boot-on;
    };

    vreg_l13a: regulator-l13a {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-1.8-cx";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
        regulator-boot-on;
    };

    vreg_usb3: regulator-usb3 {
        compatible = "qcom,pm8005-regulator";
        regulator-name = "vdd-usb3-3.3v";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-boot-on;
    };

    /* 1GB DDR4内存（海力士H5AN8G6NDJRXNC） */
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x40000000>; // 起始地址0x40000000，大小1GB
    };

    /* 启动参数（内核启动必需） */
    chosen {
        bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial_dm,0x078af000 rootfstype=squashfs,jffs2 rootwait";
    };

    /* 设备别名（简化系统引用） */
    aliases {
        led-boot = &led_power;
        led-failsafe = &led_power;
        led-running = &led_power;
        led-upgrade = &led_power;
        serial0 = &blsp1_uart0;
        ethernet0 = &gmac0;
        wifi0 = &wlan_2g;  // 2.4G无线
        wifi1 = &wlan_5g;  // 5G无线
    };

    /* LED配置（匹配物理灯位） */
    leds {
        compatible = "gpio-leds";

        // 电源灯（绿色，常亮）
        led_power: power {
            label = "jdcloud:green:power";
            gpios = <&tlmm 32 GPIO_ACTIVE_LOW>; // 需验证实际GPIO
            default-state = "on";
            retain-state-suspended;
        };

        // 2.4G无线灯（蓝色，关联无线状态）
        led_wifi_2g: wifi-2g {
            label = "jdcloud:blue:wifi2g";
            gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
            default-state = "off";
            linux,default-trigger = "phy0tpt"; // 无线激活时点亮
        };

        // 5G无线灯（蓝色，关联无线状态）
        led_wifi_5g: wifi5g {
            label = "jdcloud:blue:wifi5g";
            gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
            default-state = "off";
            linux,default-trigger = "phy1tpt";
        };

        // Joy键RGB灯（多功能指示）
        led_joy: joy {
            label = "jdcloud:rgb:joy";
            gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
            default-state = "off";
            retain-state-suspended;
        };
    };

    /* 按键配置（物理功能映射） */
    keys {
        compatible = "gpio-keys";

        // 复位键（长按恢复出厂）
        reset {
            label = "reset";
            gpios = <&tlmm 30 GPIO_ACTIVE_LOW>; // 需验证实际GPIO
            linux,code = <KEY_RESTART>;
            debounce-interval = <200>; // 消抖时间200ms
        };

        // Joy键（控制LED/mesh组网）
        joy {
            label = "joy";
            gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_FN>; // 映射为功能键
            debounce-interval = <200>;
        };
    };
};

/* 调试串口（UART0，GPIO18/19） */
&blsp1_uart0 {
    pinctrl-0 = <&serial_0_pins>;
    pinctrl-names = "default";
    status = "okay";
};

/* 128GB eMMC（时创意E128CSDA2ABE00） */
&sdhc {
    compatible = "qcom,ipq5332-sdhci", "qcom,sdhci-msm-v5";
    reg = <0x07804000 0x1000>, <0x07805000 0x1000>;
    interrupts = <GIC_SPI 313 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_SDCC1_AHB_CLK>,
             <&gcc GCC_SDCC1_APPS_CLK>,
             <&xo_board>;
    clock-names = "iface", "core", "xo";
    bus-width = <8>; // 8位数据总线
    non-removable; // 板载不可移除
    no-1-8-v; // 工作电压3.3V（非1.8V）
    cap-mmc-highspeed; // 启用高速模式
    max-frequency = <200000000>; // 最高200MHz
    status = "okay";

    /* eMMC分区表（与U-Boot严格匹配） */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        partition@0 {
            label = "boot";
            reg = <0x0 0x800000>; // 8MB（引导分区）
        };
        partition@800000 {
            label = "kernel";
            reg = <0x800000 0x1000000>; // 16MB（内核分区）
        };
        partition@1800000 {
            label = "rootfs";
            reg = <0x1800000 0x7E800000>; // 约2GB（根文件系统）
        };
        partition@80000000 {
            label = "data";
            reg = <0x80000000 0x380000000>; // 剩余空间（约14GB用户数据）
        };
    };
};

/* USB 3.0接口 */
&usb3 {
    compatible = "qcom,dwc3";
    reg = <0x08800000 0x10000>;
    interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_USB30_MASTER_CLK>,
             <&gcc GCC_USB30_SLEEP_CLK>;
    clock-names = "core", "sleep";
    dr_mode = "host"; // 主机模式
    vbus-supply = <&vreg_usb3>; // 3.3V供电
    status = "okay";

    /* USB 3.0 PHY配置 */
    usb3_phy: phy {
        compatible = "qcom,ipq5332-usb3-phy";
        #phy-cells = <0>;
        clocks = <&gcc GCC_USB30_MASTER_CLK>,
                 <&xo_board>;
        clock-names = "ref", "xo";
        status = "okay";
    };
};

/* 以太网控制器（连接QCA8386交换芯片） */
&gmac0 {
    status = "okay";
    pinctrl-0 = <&gmac0_pins>;
    pinctrl-names = "default";
    phy-mode = "rgmii"; // 与交换芯片接口模式
    phy-handle = <&qca8386>; // 关联交换芯片

    /* 与交换芯片的2.5G连接 */
    fixed-link {
        speed = <2500>; // 2.5Gbps速率
        full-duplex;
        pause; // 支持流量控制
    };
};

/* MDIO总线（管理QCA8386交换芯片） */
&mdio {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    /* QCA8386 2.5G交换芯片（1WAN+3LAN） */
    qca8386: switch@0 {
        compatible = "qca,qca8386";
        reg = <0x0>; // MDIO地址0
        reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>; // 复位引脚（需验证）
        reset-assert-us = <10000>; // 复位断言时间10ms
        reset-deassert-us = <10000>; // 复位释放时间10ms

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            // LAN口1（物理网口2）
            port@0 {
                reg = <0>;
                label = "lan1";
                phy-mode = "rgmii";
            };

            // LAN口2（物理网口3）
            port@1 {
                reg = <1>;
                label = "lan2";
                phy-mode = "rgmii";
            };

            // LAN口3（物理网口4）
            port@2 {
                reg = <2>;
                label = "lan3";
                phy-mode = "rgmii";
            };

            // WAN口（物理网口1）
            port@5 {
                reg = <5>;
                label = "wan";
                phy-mode = "rgmii";
                // VLAN隔离配置（与固件网络配置匹配）
                vlan-mode = "secure";
                vlan = <1 0x2>; // 归属VLAN 1，标记为WAN
            };

            // CPU端口（连接IPQ5332的gmac0）
            port@6 {
                reg = <6>;
                label = "cpu";
                phy-mode = "rgmii";
                fixed-link {
                    speed = <2500>;
                    full-duplex;
                    pause;
                };
            };
        };
    };
};

/* 2.4G无线（IPQ5332内置，Wi-Fi 7） */
&wlan_2g {
    compatible = "qcom,ath11k";
    status = "okay";
    qcom,chip-id = <0x0>; // 内置2.4G芯片ID
    qcom,board-id = <0x200>; // 校准ID（需匹配实际校准数据）
    vdd-0.8-cx-mx-supply = <&vreg_l12a>; // 0.8V供电
    vdd-1.8-cx-supply = <&vreg_l13a>; // 1.8V供电
    pinctrl-0 = <&wlan2g_pins>;
    pinctrl-names = "default";
};

/* 5G无线（QCN6224，PCIe接口） */
&pcie0 {
    compatible = "qcom,ipq5332-pcie";
    reg = <0x10000000 0x1000000>;
    interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&gcc GCC_PCIE0_CLK>,
             <&gcc GCC_PCIE0_AHB_CLK>;
    clock-names = "core", "iface";
    num-lanes = <1>; // 1条PCIe通道
    status = "okay";
    pinctrl-0 = <&pcie0_pins>;
    pinctrl-names = "default";

    wlan_5g: wifi@0,0 {
        compatible = "qcom,ath11k";
        reg = <0 0 0 0 0>; // PCIe地址映射
        qcom,chip-id = <0x6224>; // QCN6224芯片ID
        qcom,board-id = <0x1000>; // 校准ID
        qcom,160mhz-support = <1>;
        qcom,mlo-support = <1>;
        vdd-0.8-cx-mx-supply = <&vreg_l12a>;
        vdd-1.8-cx-supply = <&vreg_l13a>;
        status = "okay";
    };
};

/* 引脚复用控制器（TLMM） */
&tlmm {
    /* GMAC0 RGMII引脚（连接QCA8386） */
    gmac0_pins: gmac0-state {
        mux {
            pins = "gpio4",  // RGMII_MDC
                   "gpio5",  // RGMII_MDIO
                   "gpio6",  // RGMII_TXD0
                   "gpio7",  // RGMII_TXD1
                   "gpio8",  // RGMII_TXD2
                   "gpio9",  // RGMII_TXD3
                   "gpio10", // RGMII_TX_CTRL
                   "gpio11", // RGMII_TX_CLK
                   "gpio12", // RGMII_RXD0
                   "gpio13", // RGMII_RXD1
                   "gpio14", // RGMII_RXD2
                   "gpio15", // RGMII_RXD3
                   "gpio16", // RGMII_RX_CTRL
                   "gpio17"; // RGMII_RX_CLK
            function = "rgmii";
            drive-strength = <16>; // 16mA驱动强度
            bias-disable; // 无上下拉
        };
    };

    /* PCIe0引脚（连接QCN6224） */
    pcie0_pins: pcie0-state {
        mux {
            pins = "gpio48",  // PCIe_RST_N（复位）
                   "gpio49";  // PCIe_CLKREQ（时钟请求）
            function = "pcie";
            drive-strength = <8>;
            bias-pull-up; // 复位引脚默认上拉（有效）
        };
    };

    /* 2.4G无线控制引脚 */
    wlan2g_pins: wlan2g-state {
        mux {
            pins = "gpio50",  // WLAN_2G_RST（复位）
                   "gpio51";  // WLAN_2G_EN（使能）
            function = "wlan";
            drive-strength = <8>;
            bias-pull-up; // 默认使能
        };
    };
};

/* CPU频率配置（匹配1.5GHz硬件规格） */
&cpu_opp_table {
    opp-1500000000 {
        opp-hz = /bits/ 64 <1500000000>; // 1.5GHz
        clock-latency-ns = <200000>; // 频率切换延迟200us
    };
};
